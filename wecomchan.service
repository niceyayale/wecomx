[Unit]
Description=Personal WeComX push gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wecomchan
Group=wecomchan
WorkingDirectory=/opt/wecomchan
EnvironmentFile=/etc/wecomchan.env
ExecStart=/opt/wecomchan/wecomchan
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
